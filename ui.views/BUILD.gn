group("default") {
  deps = [
    ":liew_bridge",
    ":liew_bridge_recipe",
  ]
}

# Keep the minimal recipe executable edge in the generated Ninja graph so
# build.py can read its compile/link command without building that executable.
group("liew_bridge_recipe") {
  deps = [ "//.liew/examples/views_smoke:liew_link_recipe" ]
}

# Build the complete object/library/resource closure consumed by liew.dll.
# The separate views_smoke executable remains an explicit diagnostic only.
group("liew_bridge") {
  deps = [
    "//.liew/examples/views_smoke:liew_resources",
    "//base",
    "//components/viz/host",
    "//components/viz/service",
    "//mojo/core/embedder",
    "//services/viz/public/cpp/gpu:context_provider",
    "//third_party/perfetto/src/trace_processor:export_json",
    "//third_party/perfetto/src/trace_processor:storage_minimal",
    "//ui/aura",
    "//ui/base",
    "//ui/base/ime",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/gl",
    "//ui/views:views",
    "//ui/wm",
  ]
}

group("default") {
  testonly = true
  deps = [
    ":liew_bridge",
    ":liew_bridge_recipe",
  ]
}

# Keep the executable edge in the generated Ninja graph so build.py can read
# its compile/link recipe. build.py explicitly builds only :liew_bridge, so the
# recipe remains discoverable without linking views_smoke.exe on daily builds.
group("liew_bridge_recipe") {
  testonly = true
  deps = [ "//.liew/examples/views_smoke" ]
}

# Build the complete object/library/resource closure consumed by liew.dll,
# without paying for a second giant link into views_smoke.exe. The executable
# target remains available explicitly and is also the bridge recipe source.
group("liew_bridge") {
  testonly = true
  deps = [
    "//base",
    "//base/test:test_support",
    "//components/viz/host",
    "//components/viz/service",
    "//mojo/core/embedder",
    "//third_party/perfetto/src/trace_processor:export_json",
    "//third_party/perfetto/src/trace_processor:storage_minimal",
    "//ui/aura",
    "//ui/base",
    "//ui/base/ime",
    "//ui/compositor",
    "//ui/compositor:test_support",
    "//ui/gfx",
    "//ui/gl",
    "//ui/resources:ui_test_pak",
    "//ui/views:views",
    "//ui/views:test_support",
    "//ui/wm",
  ]
}

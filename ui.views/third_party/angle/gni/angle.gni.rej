+  # 刀11 (2026-09-14): Vulkan 后端整体出局。Windows 默认后端为 D3D11,
+  # Display.cpp 的全部 vulkan 引用在 ANGLE_ENABLE_VULKAN 宏守卫内,
+  # D3D11 路径完整; viz/ui/gl 侧零 vulkan 依赖。连带出局:
+  # third_party/{vulkan-validation-layers,vulkan-loader,vulkan-tools,
+  # vulkan-utility-libraries,vulkan_memory_allocator,spirv-tools} 与
+  # angle 内部 renderer/vulkan、common/vulkan。
+  angle_enable_vulkan = false
 
   # When set to true, ANGLE will not use VK_KHR_surface and VK_KHR_swapchain

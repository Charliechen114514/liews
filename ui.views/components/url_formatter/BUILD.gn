import("//testing/libfuzzer/fuzzer_test.gni")

if (is_android) {
  import("//build/config/android/rules.gni")
}


static_library("url_formatter") {
  sources = [
    # 刀16 回收: elide_url — message_center 的 FormatUrlForSecurityDisplay 需要.
    "elide_url.cc",
    "elide_url.h",
    "spoof_checks/idn_spoof_checker_types.h",
    "url_fixer.cc",
    "url_fixer.h",
    "url_formatter.cc",
    "url_formatter.h",
  ]

  deps = [
    "//base",
    "//base:i18n",
    "//build:robolectric_buildflags",
    "//url",
  ]

  public_deps = [ "//third_party/icu" ]

  if (is_robolectric) {
    # Make jni.h available.
    configs += [ "//third_party/jdk" ]
  }
  if (is_android || is_robolectric) {
    sources += [ "url_formatter_android.cc" ]
    deps += [ "android:jni_headers" ]
  } else {
    deps += [ "//ui/gfx" ]
  }
}

if (is_android) {
  java_cpp_enum("url_formatter_java_enums_srcjar") {
  }
}



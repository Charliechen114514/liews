executable("views_media_smoke") {
  testonly = true
  sources = [ "views_media_smoke_main.cc" ]
  deps = [
    "//base",
    "//base/test:test_support",
    # media 子目标 (audio/filters/...) 有 visibility 墙, //media:media 经
    # public_deps = media_subcomponent_deps 全量转出 — 正统消费姿势。
    "//media",
    # 同 views_smoke: media/test_support 链拖入的 perfetto trace_processor
    # 符号 (ExportJson/Storage) 需显式补链。
    "//third_party/perfetto/src/trace_processor:export_json",
    "//third_party/perfetto/src/trace_processor:storage_minimal",
  ]
  if (is_win) {
    deps += [ "//build/win:default_exe_manifest" ]
  }
}

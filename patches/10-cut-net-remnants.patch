+  for (char c : name) {
+    bool bad = false;
+    for (char i : kIllegal) {
+      if (c == i) {
+        bad = true;
+        break;
+      }
+    }
+    safe += bad ? '_' : c;
+  }
+  return base::UTF8ToUTF16(safe);
+}

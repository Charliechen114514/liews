-  // Should only be used with an out-of-process display compositor.
-  DCHECK(frame_sink_manager_remote_);
-
-  FrameSinkId frame_sink_id = params->frame_sink_id;
-  FrameSinkData& data = frame_sink_data_map_[frame_sink_id];

+  DCHECK(data.IsFrameSinkRegistered());
+
+  if (data.debug_label == debug_label) {
+    return;
+  }
+
+  data.debug_label = debug_label;
+  frame_sink_manager_->SetFrameSinkDebugLabel(frame_sink_id, debug_label);
+}
